{
  "name": "paperhug",
  "version": "0.1.0",
  "description": "CLI-first print-at-home greeting card generator with prompt-only and AI image provider workflows.",
  "type": "module",
  "bin": {
    "paperhug": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "check": "node --check src/cli.js && node --test",
    "build": "node --check src/cli.js && npm run build:web && npm run build:mobile",
    "test": "node --test",
    "smoke": "node src/cli.js quick birthday --for Test --message cheerful --provider none --out tmp/smoke --force",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm run smoke && npm run package:smoke",
    "dev:web": "npm --workspace @paperhug/web run dev",
    "build:web": "npm --workspace @paperhug/web run build",
    "preview:web": "npm --workspace @paperhug/web run preview",
    "build:mobile": "npm --workspace @paperhug/mobile run build",
    "check:apps": "npm run build:web && npm run build:mobile",
    "release:readiness": "node scripts/validate-release-readiness.mjs"
  },
  "keywords": [
    "greeting-card",
    "printable",
    "ai",
    "cli",
    "pdf"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/paperhug.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/paperhug/issues"
  },
  "homepage": "https://github.com/rogerchappel/paperhug#readme"
}
